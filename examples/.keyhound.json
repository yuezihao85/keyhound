{
  "exclude": [
    "*.min.js",
    "*.map",
    "*.lock",
    "assets/**",
    "third_party/**"
  ],
  "include": [],
  "min_entropy": 4.0,
  "min_length": 20,
  "max_size_bytes": 1048576,
  "disabled_rules": [
    "jwt"
  ],
  "custom_rules": [
    {
      "id": "acme-internal-token",
      "description": "ACME internal system token",
      "severity": "high",
      "pattern": "\\bACME-[A-Z0-9]{12}\\b",
      "tags": ["internal"]
    },
    {
      "id": "legacy-db-password",
      "description": "db_pass in legacy ini files",
      "severity": "critical",
      "pattern": "(?i)db_pass\\s*=\\s*[\"']?([A-Za-z0-9_\\-]{12,})",
      "secret_group": 1,
      "min_entropy": 3.0,
      "min_length": 12,
      "tags": ["database", "legacy"]
    }
  ],
  "allowlist": [
    "^ACME-EXAMPLE[0-9]+$",
    "(?i:fixture|synthetic)"
  ],
  "use_gitignore": true,
  "fail_on": "medium"
}
